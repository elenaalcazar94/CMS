# Dominio donde vivirá el panel (apunta su DNS a este servidor)
ADMIN_DOMAIN=cms.tuagencia.com
# Email para Let's Encrypt
ACME_EMAIL=tu@agencia.com
# Contraseña de la base de datos (cámbiala)
POSTGRES_PASSWORD=cambia-esta-contraseña
# Opcional: subdominios automáticos cliente.webs.tuagencia.com (requiere DNS comodín *.webs.tuagencia.com)
ROOT_DOMAIN=
MAX_UPLOAD_MB=20
# SMTP para avisos de formularios y recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tu Agencia <no-reply@tuagencia.com>"

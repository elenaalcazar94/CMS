# Conexión a PostgreSQL
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms"

# URL pública del panel de administración (sin barra final)
APP_URL="http://localhost:3000"

# Dominio raíz opcional para subdominios automáticos: cliente.ROOT_DOMAIN
ROOT_DOMAIN=""

# Carpeta donde se guardan los archivos subidos
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20

# SMTP para enviar avisos de formularios y recuperación de contraseña (opcional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nido CMS <no-reply@example.com>"
